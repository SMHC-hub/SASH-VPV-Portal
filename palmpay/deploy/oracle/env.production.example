# VeinPay production environment — Oracle Always Free (wallet-only mode)
# Copy to /opt/veinpay/palmpay/.env and fill in secrets.
# Generate: openssl rand -hex 32

# --- Required secrets (CHANGE ALL) ---
AUTH_SECRET=
PALMPAY_JAZZCASH_WEBHOOK_SECRET=
PALMPAY_KIOSK_DEVICE_TOKEN=
PALMPAY_INTERNAL_SECRET=

# --- Wallet-only cloud (no PyTorch on server) ---
RECOGNITION_LOGS_ENABLED=false

# --- Production behaviour ---
PALMPAY_DEV_OTP=false
PALMPAY_DEV_AUTO_KYC=false

# --- SMTP (signup / password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Optional ---
API_PORT=8001
TORCH_NUM_THREADS=2

# Full ML mode (not recommended on 1 OCPU free VM):
# RECOGNITION_LOGS_ENABLED=true
# INFERENCE_DEVICE=cpu
