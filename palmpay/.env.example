AUTH_SECRET=change-this-to-a-long-random-secret
ATTENDANCE_CRON_SECRET=

MATCH_THRESHOLD=0.32
LOGIN_MATCH_THRESHOLD=0.32
ADMIN_MATCH_THRESHOLD=0.32
LOGIN_MATCH_MIN_MARGIN=0.03

# Recognition logs + ML matcher. Set false for wallet-only cloud deploy.
RECOGNITION_LOGS_ENABLED=false
INFERENCE_DEVICE=auto
TORCH_NUM_THREADS=4

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your@email.com
SMTP_USE_TLS=true
# Optional: Brevo API key (xkeysib-...) — preferred when SMTP IP allowlist blocks servers
# BREVO_API_KEY=

GOOGLE_OAUTH_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PalmPay OTP: never return codes in API JSON in production.
PALMPAY_DEV_OTP=false
# Auto-approve KYC after CNIC upload (set false when admin review exists).
PALMPAY_DEV_AUTO_KYC=true

CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(:\d+)?
